             |        +--ro position-or-label-range* []
             |           +--ro upper?   string
             |           +--ro lower?   string
             +--ro profile* [profile-uuid]
             |  +--ro profile-uuid    -> /tapi-common:context/profile/uuid
             +--ro sink-profile* [profile-uuid]
             |  +--ro profile-uuid    -> /tapi-common:context/profile/uuid
             +--ro source-profile* [profile-uuid]
             |  +--ro profile-uuid    -> /tapi-common:context/profile/uuid
             +--ro uuid?                                               uuid
