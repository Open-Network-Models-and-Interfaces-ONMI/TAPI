module: tapi-common
  +--rw context
     +--ro service-interface-point* [uuid]
     |  +--ro layer-protocol-name?                                layer-protocol-name
     |  +--ro direction?                                          direction
     |  +--ro supported-cep-layer-protocol-qualifier-instances* []
     |  |  +--ro layer-protocol-qualifier?   layer-protocol-qualifier
     |  |  +--ro number-of-cep-instances?    uint64
     |  +--ro available-cep-layer-protocol-qualifier-instances* []
     |  |  +--ro layer-protocol-qualifier?   layer-protocol-qualifier
     |  |  +--ro number-of-cep-instances?    uint64
     |  +--ro supported-payload-structure* []
     |  |  +--ro multiplexing-sequence*                     layer-protocol-qualifier
     |  |  +--ro number-of-cep-instances?                   uint64
     |  |  +--ro capacity
     |  |  |  +--ro value?   decimal64
     |  |  |  +--ro unit?    capacity-unit
     |  |  +--ro potential-cep-instance-capability* [potential-cep-instance-identifier]
     |  |  |  +--ro potential-cep-instance-identifier          string
     |  |  |  +--ro potentially-supported-position-or-label*   position-or-label
     |  |  +--ro potential-cep-instance-capability-range* [range-identifier]
     |  |     +--ro range-identifier                                 string
     |  |     +--ro potentially-supported-position-or-label-range* []
     |  |        +--ro position-or-label-range* []
     |  |           +--ro upper?   string
     |  |           +--ro lower?   string
     |  +--ro available-payload-structure* []
     |  |  +--ro multiplexing-sequence*                     layer-protocol-qualifier
     |  |  +--ro number-of-cep-instances?                   uint64
     |  |  +--ro capacity
     |  |  |  +--ro value?   decimal64
     |  |  |  +--ro unit?    capacity-unit
     |  |  +--ro potential-cep-instance-capability* [potential-cep-instance-identifier]
     |  |  |  +--ro potential-cep-instance-identifier          string
     |  |  |  +--ro potentially-supported-position-or-label*   position-or-label
     |  |  +--ro potential-cep-instance-capability-range* [range-identifier]
     |  |     +--ro range-identifier                                 string
     |  |     +--ro potentially-supported-position-or-label-range* []
     |  |        +--ro position-or-label-range* []
     |  |           +--ro upper?   string
     |  |           +--ro lower?   string
     |  +--ro profile* [profile-uuid]
     |  |  +--ro profile-uuid    -> /context/profile/uuid
     |  +--ro sink-profile* [profile-uuid]
     |  |  +--ro profile-uuid    -> /context/profile/uuid
     |  +--ro source-profile* [profile-uuid]
     |  |  +--ro profile-uuid    -> /context/profile/uuid
     |  +--ro uuid                                                uuid
     |  +--ro name* [value-name]
     |  |  +--ro value-name    string
     |  |  +--ro value?        string
     |  +--ro administrative-state?                               administrative-state
     |  +--ro operational-state?                                  operational-state
     |  +--ro lifecycle-state?                                    lifecycle-state
     |  +--ro total-potential-capacity
     |  |  +--ro total-size
     |  |     +--ro value?   decimal64
     |  |     +--ro unit?    capacity-unit
     |  +--ro available-capacity
     |     +--ro total-size
     |        +--ro value?   decimal64
     |        +--ro unit?    capacity-unit
     +--ro profile* [uuid]
     |  +--ro profile-type?                      profile-type
     |  +--ro grouped-profiles* [profile-uuid]
     |  |  +--ro profile-uuid    -> /context/profile/uuid
     |  +--ro uuid                               uuid
     |  +--ro name* [value-name]
     |  |  +--ro value-name    string
     |  |  +--ro value?        string
     |  +--ro transmission-capability-profile
     |     +--ro supported-payload-structure* []
     |        +--ro multiplexing-sequence*                     layer-protocol-qualifier
     |        +--ro number-of-cep-instances?                   uint64
     |        +--ro capacity
     |        |  +--ro value?   decimal64
     |        |  +--ro unit?    capacity-unit
     |        +--ro potential-cep-instance-capability* [potential-cep-instance-identifier]
     |        |  +--ro potential-cep-instance-identifier          string
     |        |  +--ro potentially-supported-position-or-label*   position-or-label
     |        +--ro potential-cep-instance-capability-range* [range-identifier]
     |           +--ro range-identifier                                 string
     |           +--ro potentially-supported-position-or-label-range* []
     |              +--ro position-or-label-range* []
     |                 +--ro upper?   string
     |                 +--ro lower?   string
     +--rw uuid?                      uuid
     +--rw name* [value-name]
        +--rw value-name    string
        +--rw value?        string
module: tapi-connectivity

  augment /tapi-common:context:
    +--rw connectivity-context
       +--rw connectivity-service* [uuid]
       |  +--rw layer-protocol-name?               tapi-common:layer-protocol-name
       |  +--rw layer-protocol-qualifier?          tapi-common:layer-protocol-qualifier
       |  +--rw direction?                         tapi-common:forwarding-direction
       |  +--rw end-point* [local-id]
       |  |  +--rw layer-protocol-name?                         tapi-common:layer-protocol-name
       |  |  +--rw layer-protocol-qualifier?                    tapi-common:layer-protocol-qualifier
       |  |  +--rw direction?                                   tapi-common:direction
       |  |  +--rw role?                                        tapi-common:port-role
       |  |  +--rw protection-role?                             protection-role
       |  |  +--ro csep-role* [role-name]
       |  |  |  +--ro role-name                              string
       |  |  |  +--ro connectivity-service-spec-reference
       |  |  |     +--ro connectivity-service-spec-name?   string
       |  |  |     +--ro connectivity-service-spec-id?     tapi-common:uuid
       |  |  +--rw capacity
       |  |  |  +--rw total-size
       |  |  |     +--rw value?   decimal64
       |  |  |     +--rw unit?    capacity-unit
       |  |  +--rw service-interface-point
       |  |  |  +--rw service-interface-point-uuid?   -> /tapi-common:context/service-interface-point/uuid
       |  |  +--ro connection-end-point* [topology-uuid node-uuid node-edge-point-uuid connection-end-point-uuid]
       |  |  |  +--ro topology-uuid                -> /tapi-common:context/tapi-topology:topology-context/topology/uuid
       |  |  |  +--ro node-uuid                    -> /tapi-common:context/tapi-topology:topology-context/topology/node/uuid
       |  |  |  +--ro node-edge-point-uuid         -> /tapi-common:context/tapi-topology:topology-context/topology/node/owned-node-edge-point/uuid
       |  |  |  +--ro connection-end-point-uuid    -> /tapi-common:context/tapi-topology:topology-context/topology/node/owned-node-edge-point/tapi-connectivity:cep-list/connection-end-point/uuid
       |  |  +--rw peer-fwd-connectivity-service-end-point
       |  |  |  +--rw connectivity-service-uuid?                 -> /tapi-common:context/tapi-connectivity:connectivity-context/connectivity-service/uuid
       |  |  |  +--rw connectivity-service-end-point-local-id?   -> /tapi-common:context/tapi-connectivity:connectivity-context/connectivity-service/end-point/local-id
       |  |  +--rw server-connectivity-service-end-point
       |  |  |  +--rw connectivity-service-uuid?                 -> /tapi-common:context/tapi-connectivity:connectivity-context/connectivity-service/uuid
       |  |  |  +--rw connectivity-service-end-point-local-id?   -> /tapi-common:context/tapi-connectivity:connectivity-context/connectivity-service/end-point/local-id
       |  |  +--rw protecting-connectivity-service-end-point
       |  |  |  +--rw connectivity-service-uuid?                 -> /tapi-common:context/tapi-connectivity:connectivity-context/connectivity-service/uuid
       |  |  |  +--rw connectivity-service-end-point-local-id?   -> /tapi-common:context/tapi-connectivity:connectivity-context/connectivity-service/end-point/local-id
       |  |  +--rw assembled-connectivity-service-end-point* [connectivity-service-uuid connectivity-service-end-point-local-id]
       |  |  |  +--rw connectivity-service-uuid                  -> /tapi-common:context/tapi-connectivity:connectivity-context/connectivity-service/uuid
       |  |  |  +--rw connectivity-service-end-point-local-id    -> /tapi-common:context/tapi-connectivity:connectivity-context/connectivity-service/end-point/local-id
       |  |  +--rw layer-protocol-constraint* [local-id]
       |  |  |  +--rw layer-protocol-name?        tapi-common:layer-protocol-name
       |  |  |  +--rw layer-protocol-qualifier?   tapi-common:layer-protocol-qualifier
       |  |  |  +--rw local-id                    string
       |  |  |  +--rw name* [value-name]
       |  |  |     +--rw value-name    string
       |  |  |     +--rw value?        string
       |  |  +--rw profile* [profile-uuid]
       |  |  |  +--rw profile-uuid    -> /tapi-common:context/profile/uuid
       |  |  +--rw sink-profile* [profile-uuid]
       |  |  |  +--rw profile-uuid    -> /tapi-common:context/profile/uuid
       |  |  +--rw source-profile* [profile-uuid]
       |  |  |  +--rw profile-uuid    -> /tapi-common:context/profile/uuid
       |  |  +--rw local-id                                     string
       |  |  +--rw name* [value-name]
       |  |  |  +--rw value-name    string
       |  |  |  +--rw value?        string
       |  |  +--rw administrative-state?                        administrative-state
       |  |  +--ro operational-state?                           operational-state
       |  |  +--ro lifecycle-state?                             lifecycle-state
       |  +--rw connectivity-constraint
       |  |  +--rw service-type?           service-type
       |  |  +--rw service-level?          string
       |  |  +--rw requested-capacity
       |  |  |  +--rw total-size
       |  |  |     +--rw value?   decimal64
       |  |  |     +--rw unit?    capacity-unit
       |  |  +--rw schedule
       |  |  |  +--rw start-time?   date-and-time
       |  |  |  +--rw end-time?     date-and-time
       |  |  +--rw coroute-inclusion
       |  |  |  +--rw connectivity-service-uuid?   -> /tapi-common:context/tapi-connectivity:connectivity-context/connectivity-service/uuid
       |  |  +--rw diversity-exclusion* [connectivity-service-uuid]
       |  |  |  +--rw connectivity-service-uuid    -> /tapi-common:context/tapi-connectivity:connectivity-context/connectivity-service/uuid
       |  |  +--rw connection-inclusion* [connection-uuid]
       |  |  |  +--rw connection-uuid    -> /tapi-common:context/tapi-connectivity:connectivity-context/connection/uuid
       |  |  +--rw connection-exclusion* [connection-uuid]
       |  |     +--rw connection-uuid    -> /tapi-common:context/tapi-connectivity:connectivity-context/connection/uuid
       |  +--rw routing-constraint
       |  |  +--rw cost-characteristic* [cost-name]
       |  |  |  +--rw cost-name         string
       |  |  |  +--rw cost-value?       string
       |  |  |  +--rw cost-algorithm?   string
       |  |  +--rw latency-characteristic* [traffic-property-name]
       |  |  |  +--rw traffic-property-name             string
       |  |  |  +--ro fixed-latency-characteristic?     string
       |  |  |  +--rw queuing-latency-characteristic?   string
       |  |  |  +--ro jitter-characteristic?            string
       |  |  |  +--ro wander-characteristic?            string
       |  |  +--rw risk-diversity-characteristic* [risk-characteristic-name]
       |  |  |  +--rw risk-characteristic-name    string
       |  |  |  +--rw risk-identifier-list*       string
       |  |  +--rw diversity-policy?                diversity-policy
       |  |  +--rw route-objective-function?        route-objective-function
       |  |  +--rw is-exclusive?                    boolean
       |  |  +--rw tolerable-impact?                grades-of-impact
       |  |  +--rw max-allowed-cost
       |  |  |  +--rw value?      uint64
       |  |  |  +--rw priority?   uint64
       |  |  +--rw max-allowed-hops
       |  |  |  +--rw value?      uint64
       |  |  |  +--rw priority?   uint64
       |  |  +--rw max-allowed-delay
       |  |     +--rw value?      uint64
       |  |     +--rw priority?   uint64
       |  +--rw topology-constraint* [local-id]
       |  |  +--rw explicit-route?                        boolean
       |  |  +--rw preferred-transport-layer?             tapi-common:layer-protocol-name
       |  |  +--rw constraint-weight?                     uint64
       |  |  +--rw include-topology* [topology-uuid]
       |  |  |  +--rw topology-uuid    -> /tapi-common:context/tapi-topology:topology-context/topology/uuid
       |  |  +--rw exclude-topology* [topology-uuid]
       |  |  |  +--rw topology-uuid    -> /tapi-common:context/tapi-topology:topology-context/topology/uuid
       |  |  +--rw include-path* [path-uuid]
       |  |  |  +--rw path-uuid    -> /tapi-common:context/tapi-path-computation:path-computation-context/path/uuid
       |  |  +--rw exclude-path* [path-uuid]
       |  |  |  +--rw path-uuid    -> /tapi-common:context/tapi-path-computation:path-computation-context/path/uuid
       |  |  +--rw include-link* [topology-uuid link-uuid]
       |  |  |  +--rw topology-uuid    -> /tapi-common:context/tapi-topology:topology-context/topology/uuid
       |  |  |  +--rw link-uuid        -> /tapi-common:context/tapi-topology:topology-context/topology/link/uuid
       |  |  +--rw exclude-link* [topology-uuid link-uuid]
       |  |  |  +--rw topology-uuid    -> /tapi-common:context/tapi-topology:topology-context/topology/uuid
       |  |  |  +--rw link-uuid        -> /tapi-common:context/tapi-topology:topology-context/topology/link/uuid
       |  |  +--rw include-link-and-partition* [index]
       |  |  |  +--rw index             uint64
       |  |  |  +--rw partition-type?   partition-type
       |  |  |  +--rw link
       |  |  |     +--rw topology-uuid?   -> /tapi-common:context/tapi-topology:topology-context/topology/uuid
       |  |  |     +--rw link-uuid?       -> /tapi-common:context/tapi-topology:topology-context/topology/link/uuid
       |  |  +--rw exclude-link-and-partition* [index]
       |  |  |  +--rw index             uint64
       |  |  |  +--rw partition-type?   partition-type
       |  |  |  +--rw link
       |  |  |     +--rw topology-uuid?   -> /tapi-common:context/tapi-topology:topology-context/topology/uuid
       |  |  |     +--rw link-uuid?       -> /tapi-common:context/tapi-topology:topology-context/topology/link/uuid
       |  |  +--rw include-node* [topology-uuid node-uuid]
       |  |  |  +--rw topology-uuid    -> /tapi-common:context/tapi-topology:topology-context/topology/uuid
       |  |  |  +--rw node-uuid        -> /tapi-common:context/tapi-topology:topology-context/topology/node/uuid
       |  |  +--rw exclude-node* [topology-uuid node-uuid]
       |  |  |  +--rw topology-uuid    -> /tapi-common:context/tapi-topology:topology-context/topology/uuid
       |  |  |  +--rw node-uuid        -> /tapi-common:context/tapi-topology:topology-context/topology/node/uuid
       |  |  +--rw include-node-edge-point* [topology-uuid node-uuid node-edge-point-uuid]
       |  |  |  +--rw topology-uuid           -> /tapi-common:context/tapi-topology:topology-context/topology/uuid
       |  |  |  +--rw node-uuid               -> /tapi-common:context/tapi-topology:topology-context/topology/node/uuid
       |  |  |  +--rw node-edge-point-uuid    -> /tapi-common:context/tapi-topology:topology-context/topology/node/owned-node-edge-point/uuid
       |  |  +--rw exclude-node-edge-point* [topology-uuid node-uuid node-edge-point-uuid]
       |  |  |  +--rw topology-uuid           -> /tapi-common:context/tapi-topology:topology-context/topology/uuid
       |  |  |  +--rw node-uuid               -> /tapi-common:context/tapi-topology:topology-context/topology/node/uuid
       |  |  |  +--rw node-edge-point-uuid    -> /tapi-common:context/tapi-topology:topology-context/topology/node/owned-node-edge-point/uuid
       |  |  +--rw include-nep-and-partition* [index]
       |  |  |  +--rw index              uint64
       |  |  |  +--rw partition-type?    partition-type
       |  |  |  +--rw node-edge-point
       |  |  |     +--rw topology-uuid?          -> /tapi-common:context/tapi-topology:topology-context/topology/uuid
       |  |  |     +--rw node-uuid?              -> /tapi-common:context/tapi-topology:topology-context/topology/node/uuid
       |  |  |     +--rw node-edge-point-uuid?   -> /tapi-common:context/tapi-topology:topology-context/topology/node/owned-node-edge-point/uuid
       |  |  +--rw exclude-nep-and-partition* [index]
       |  |  |  +--rw index              uint64
       |  |  |  +--rw partition-type?    partition-type
       |  |  |  +--rw node-edge-point
       |  |  |     +--rw topology-uuid?          -> /tapi-common:context/tapi-topology:topology-context/topology/uuid
       |  |  |     +--rw node-uuid?              -> /tapi-common:context/tapi-topology:topology-context/topology/node/uuid
       |  |  |     +--rw node-edge-point-uuid?   -> /tapi-common:context/tapi-topology:topology-context/topology/node/owned-node-edge-point/uuid
       |  |  +--rw local-id                               string
       |  |  +--rw name* [value-name]
       |  |  |  +--rw value-name    string
       |  |  |  +--rw value?        string
       |  |  +--rw connection-and-route-constraint
       |  |  |  +--rw include-connection-and-route* [index]
       |  |  |  |  +--rw index         uint64
       |  |  |  |  +--rw connection
       |  |  |  |  |  +--rw connection-uuid?   -> /tapi-common:context/tapi-connectivity:connectivity-context/connection/uuid
       |  |  |  |  +--rw route
       |  |  |  |     +--rw connection-uuid?   -> /tapi-common:context/tapi-connectivity:connectivity-context/connection/uuid
       |  |  |  |     +--ro route-local-id?    -> /tapi-common:context/tapi-connectivity:connectivity-context/connection/route/local-id
       |  |  |  +--rw exclude-connection-and-route* [index]
       |  |  |     +--rw index         uint64
       |  |  |     +--rw connection
       |  |  |     |  +--rw connection-uuid?   -> /tapi-common:context/tapi-connectivity:connectivity-context/connection/uuid
       |  |  |     +--rw route
       |  |  |        +--rw connection-uuid?   -> /tapi-common:context/tapi-connectivity:connectivity-context/connection/uuid
       |  |  |        +--ro route-local-id?    -> /tapi-common:context/tapi-connectivity:connectivity-context/connection/route/local-id
       |  |  +--rw connection-and-partition-constraint
       |  |     +--rw include-connection-and-partition
       |  |     |  +--rw index?            uint64
       |  |     |  +--rw partition-type?   tapi-path-computation:partition-type
       |  |     |  +--rw connection
       |  |     |     +--rw connection-uuid?   -> /tapi-common:context/tapi-connectivity:connectivity-context/connection/uuid
       |  |     +--rw exclude-connection-and-partition
       |  |        +--rw index?            uint64
       |  |        +--rw partition-type?   tapi-path-computation:partition-type
       |  |        +--rw connection
       |  |           +--rw connection-uuid?   -> /tapi-common:context/tapi-connectivity:connectivity-context/connection/uuid
       |  +--rw resilience-constraint
       |  |  +--rw resilience-type
