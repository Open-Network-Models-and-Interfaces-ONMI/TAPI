             |     +--ro potentially-supported-position-or-label-range* []
             |        +--ro position-or-label-range* []
             |           +--ro upper?   string
             |           +--ro lower?   string
             +--ro available-payload-structure* []
             |  +--ro multiplexing-sequence*                     layer-protocol-qualifier
             |  +--ro number-of-cep-instances?                   uint64
             |  +--ro capacity
