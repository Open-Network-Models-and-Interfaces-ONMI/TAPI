             +--ro any-class {tapi-streaming}?
             +--ro stream-monitor {tapi-streaming-admin}?
             |  +--ro id-of-last-record-read-from-log?    string
             |  +--ro id-of-last-record-written-to-log?   string
             |  +--ro available-stream
