          |     +--rw value?        string
          +--rw schedule
          |  +--rw start-time?   date-and-time
          |  +--rw end-time?     date-and-time
          +--rw state
          |  +--rw administrative-state?   administrative-state
          |  +--ro operational-state?      operational-state
          |  +--ro lifecycle-state?        lifecycle-state
          +--rw uuid                   uuid
          +--rw name* [value-name]
             +--rw value-name    string
             +--rw value?        string
