module: tapi-physical-route

  augment /tapi-common:context/tapi-connectivity:connectivity-context/tapi-connectivity:connection:
    +--ro physical-route-list
       +--ro physical-route* [local-id]
          +--ro physical-route-element* []
          |  +--ro access-port-in-route
          |  |  +--ro device-uuid?        -> /tapi-common:context/tapi-equipment:physical-context/device/uuid
          |  |  +--ro access-port-uuid?   -> /tapi-common:context/tapi-equipment:physical-context/device/access-port/uuid
          |  +--ro connector-pin-in-route* []
          |     +--ro connector-identification?   string
          |     +--ro pin-identification?         string
          |     +--ro equipment-uuid?             tapi-common:uuid
          |     +--ro pin-and-role* []
          |        +--ro location-in-connector?   string
          |        +--ro pin-role*                string
          |        +--ro pin-name?                string
          +--ro physical-route-state?     physical-route-state
          +--ro local-id                  string
          +--ro name* [value-name]
             +--ro value-name    string
             +--ro value?        string
  augment /tapi-common:context/tapi-notification:notification-context/tapi-notification:notification:
    +--ro physical-route
       +--ro physical-route-element* []
       |  +--ro access-port-in-route
       |  |  +--ro device-uuid?        -> /tapi-common:context/tapi-equipment:physical-context/device/uuid
       |  |  +--ro access-port-uuid?   -> /tapi-common:context/tapi-equipment:physical-context/device/access-port/uuid
       |  +--ro connector-pin-in-route* []
       |     +--ro connector-identification?   string
       |     +--ro pin-identification?         string
       |     +--ro equipment-uuid?             tapi-common:uuid
       |     +--ro pin-and-role* []
       |        +--ro location-in-connector?   string
       |        +--ro pin-role*                string
       |        +--ro pin-name?                string
       +--ro physical-route-state?     physical-route-state
       +--ro local-id?                 string
       +--ro name* [value-name]
          +--ro value-name    string
          +--ro value?        string
  augment /tapi-streaming:stream-record/tapi-streaming:log-record/tapi-streaming:log-record-body:
    +--ro physical-route
       +--ro physical-route-element* []
       |  +--ro access-port-in-route
       |  |  +--ro device-uuid?        -> /tapi-common:context/tapi-equipment:physical-context/device/uuid
       |  |  +--ro access-port-uuid?   -> /tapi-common:context/tapi-equipment:physical-context/device/access-port/uuid
       |  +--ro connector-pin-in-route* []
       |     +--ro connector-identification?   string
       |     +--ro pin-identification?         string
       |     +--ro equipment-uuid?             tapi-common:uuid
       |     +--ro pin-and-role* []
       |        +--ro location-in-connector?   string
       |        +--ro pin-role*                string
       |        +--ro pin-name?                string
       +--ro physical-route-state?     physical-route-state
       +--ro local-id?                 string
       +--ro name* [value-name]
          +--ro value-name    string
          +--ro value?        string
  augment /tapi-common:context/tapi-notification:notification-context/tapi-notification:notification:
    +--ro physical-route-element
       +--ro access-port-in-route
       |  +--ro device-uuid?        -> /tapi-common:context/tapi-equipment:physical-context/device/uuid
       |  +--ro access-port-uuid?   -> /tapi-common:context/tapi-equipment:physical-context/device/access-port/uuid
       +--ro connector-pin-in-route* []
          +--ro connector-identification?   string
          +--ro pin-identification?         string
          +--ro equipment-uuid?             tapi-common:uuid
          +--ro pin-and-role* []
             +--ro location-in-connector?   string
             +--ro pin-role*                string
             +--ro pin-name?                string
  augment /tapi-streaming:stream-record/tapi-streaming:log-record/tapi-streaming:log-record-body:
    +--ro physical-route-element
       +--ro access-port-in-route
       |  +--ro device-uuid?        -> /tapi-common:context/tapi-equipment:physical-context/device/uuid
       |  +--ro access-port-uuid?   -> /tapi-common:context/tapi-equipment:physical-context/device/access-port/uuid
       +--ro connector-pin-in-route* []
          +--ro connector-identification?   string
          +--ro pin-identification?         string
          +--ro equipment-uuid?             tapi-common:uuid
          +--ro pin-and-role* []
             +--ro location-in-connector?   string
             +--ro pin-role*                string
             +--ro pin-name?                string
  augment /tapi-notification:notification:
    +--ro physical-route
       +--ro physical-route-element* []
       |  +--ro access-port-in-route
       |  |  +--ro device-uuid?        -> /tapi-common:context/tapi-equipment:physical-context/device/uuid
       |  |  +--ro access-port-uuid?   -> /tapi-common:context/tapi-equipment:physical-context/device/access-port/uuid
       |  +--ro connector-pin-in-route* []
       |     +--ro connector-identification?   string
       |     +--ro pin-identification?         string
       |     +--ro equipment-uuid?             tapi-common:uuid
       |     +--ro pin-and-role* []
       |        +--ro location-in-connector?   string
       |        +--ro pin-role*                string
       |        +--ro pin-name?                string
       +--ro physical-route-state?     physical-route-state
       +--ro local-id?                 string
       +--ro name* [value-name]
          +--ro value-name    string
          +--ro value?        string
  augment /tapi-notification:notification:
    +--ro physical-route-element
       +--ro access-port-in-route
       |  +--ro device-uuid?        -> /tapi-common:context/tapi-equipment:physical-context/device/uuid
       |  +--ro access-port-uuid?   -> /tapi-common:context/tapi-equipment:physical-context/device/access-port/uuid
       +--ro connector-pin-in-route* []
          +--ro connector-identification?   string
          +--ro pin-identification?         string
          +--ro equipment-uuid?             tapi-common:uuid
          +--ro pin-and-role* []
             +--ro location-in-connector?   string
             +--ro pin-role*                string
             +--ro pin-name?                string
